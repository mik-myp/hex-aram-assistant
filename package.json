{
  "name": "hex-aram-assistant",
  "version": "0.5.2",
  "description": "HexBuddy (海斗军师) — 英雄联盟端游海克斯大乱斗新手桌面助手（100% 纯只读安全模式）",
  "main": "./out/main/index.js",
  "author": "mik-myp",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "fetch-seed": "node scripts/fetch-seed-data.mjs && node scripts/build-icon-fingerprints.mjs",
    "build:icons": "node scripts/build-icon-fingerprints.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check:arch": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check": "pnpm check:arch && pnpm typecheck && pnpm test",
    "pack:mac": "electron-vite build && electron-builder --mac --dir",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "koffi": "^3.3.8",
    "lucide-react": "^0.511.0",
    "pinyin-pro": "^3.26.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.1",
    "tesseract.js": "^6.0.1",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "build": {
    "appId": "com.mikmyp.hexbuddy",
    "productName": "HexBuddy",
    "icon": "resources/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "resources/seed-data",
        "to": "seed-data"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "target": "dmg",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "HexBuddy 海斗军师",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
